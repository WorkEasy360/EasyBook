# Django REST API base. Server-side only — never exposed to the browser:
# the BFF route handlers (src/app/api/bff) are the browser's only path in.
API_BASE_URL=http://127.0.0.1:8001/api/v1

# Cookie flags. Set to 1 in any environment served over HTTPS.
SESSION_COOKIE_SECURE=0

# Optional: overrides the Playwright base URL and skips starting `next dev`.
# E2E_BASE_URL=http://127.0.0.1:3000

# Rate-limit identity. Django is only ever reached from this server, so the
# browser's address is forwarded to it — trusted there only alongside the
# shared secret (backend/core/client_ip.py). Without these, every browser user
# counts as one client against Django's sign-in and anonymous limits.
# TRUSTED_PROXY_COUNT: reverse proxies in front of THIS server that append to
# X-Forwarded-For (0 locally, 1 behind one load balancer). Never more than
# actually exist, or a client can choose its own address.
TRUSTED_PROXY_COUNT=0
# Must equal the API's BFF_PROXY_SECRET (Terraform generates it:
# `terraform output` -> Secrets Manager <name>/bff-proxy-secret).
BFF_PROXY_SECRET=
