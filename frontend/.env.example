# Django REST API base. Server-side only — never exposed to the browser:
# the BFF route handlers (src/app/api/bff) are the browser's only path in.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Cookie flags. Set to 1 in any environment served over HTTPS.
SESSION_COOKIE_SECURE=0

# Optional: overrides the Playwright base URL and skips starting `next dev`.
# E2E_BASE_URL=http://127.0.0.1:3000
