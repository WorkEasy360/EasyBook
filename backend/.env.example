DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=easybook
DB_USER=easybook_app
DB_PASSWORD=easybook_app
# 127.0.0.1, NOT localhost. On Windows "localhost" resolves to ::1 first, but
# Docker publishes these ports on IPv4 only, so every new connection stalls
# ~2s before falling back — and Django opens a fresh DB, Redis and Celery-broker
# connection per request (CONN_MAX_AGE=0), which made every API call take 12s+.
DB_HOST=127.0.0.1
DB_PORT=5472

REDIS_URL=redis://127.0.0.1:6390/0

CORS_ALLOWED_ORIGINS=http://localhost:3000
