DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=easybook
DB_USER=easybook_app
DB_PASSWORD=easybook_app
# 127.0.0.1, NOT localhost. On Windows "localhost" resolves to ::1 first, but
# Docker publishes these ports on IPv4 only, so every new connection stalls
# ~2s before falling back — and Django opens a fresh DB, Redis and Celery-broker
# connection per request (CONN_MAX_AGE=0), which made every API call take 12s+.
DB_HOST=127.0.0.1
DB_PORT=5472

REDIS_URL=redis://127.0.0.1:6390/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Workeasy360 sign-in (docs/workeasy360-sso.md). Leave the WORKEASY360_* values
# empty locally to keep using passwords (dev settings default SSO_ONLY off).
WORKEASY360_SSO_ONLY=0
WORKEASY360_ISSUER=
WORKEASY360_CLIENT_ID=
WORKEASY360_REDIRECT_URI=http://localhost:3000/api/auth/callback/workeasy360
WORKEASY360_KEY_ID=
WORKEASY360_PRIVATE_KEY_FILE=
# Optional: offers "Sign out of EasyBook and Workeasy360" (registered in
# Workeasy360 as a post-logout URI), e.g. http://localhost:3000/login
WORKEASY360_POST_LOGOUT_REDIRECT_URI=
