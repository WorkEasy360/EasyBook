# Python / Django
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
db.sqlite3
staticfiles/
mediafiles/
backend/private_media/

# Env / secrets
.env
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
coverage/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker volumes are managed by Docker itself, not the repo

# Terraform (infrastructure/terraform) — .terraform.lock.hcl IS committed
# (pins provider versions); local state/plan files and the downloaded
# provider cache are not.
infrastructure/terraform/**/.terraform/
infrastructure/terraform/**/*.tfstate
infrastructure/terraform/**/*.tfstate.*
infrastructure/terraform/**/*.tflock
infrastructure/terraform/**/*.tfplan
infrastructure/terraform/**/*.tfvars
!infrastructure/terraform/**/*.tfvars.example
# Backend config files hold no secrets (bucket/key/region only) and belong in
# git so every environment initialises the same way; the example is the
# template for them.
crash.log
crash.*.log
